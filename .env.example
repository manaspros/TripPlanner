# TripPlanner Environment Variables
# Copy this file to .env and fill in your API keys

# === Required: Google Gemini AI ===
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# === Optional: Google Places API ===
# Get your key from: https://console.cloud.google.com/
# Used for real restaurant and place data
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# === Optional: OpenWeather API (for Weather MCP) ===
# Get your key from: https://openweathermap.org/api
# Free tier: 1,000 calls/day
OPENWEATHER_API_KEY=your_openweather_api_key_here

# === Server Configuration ===
DEBUG=true
HOST=127.0.0.1
PORT=8000

# === MCP Configuration ===
# Directory to store saved travel plans
MCP_STORAGE_PATH=./travel-plans

# === Optional: Additional API Keys ===
# OPENAI_API_KEY=your_openai_key_here
# BRAVE_API_KEY=your_brave_search_key_here
# GOOGLE_MAPS_API_KEY=your_google_maps_key_here
